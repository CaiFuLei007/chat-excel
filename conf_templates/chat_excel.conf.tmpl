# chat-excel 单服务容器配置模板
# 以 envsubst 渲染 : ${变量} 将被同名环境变量的值替换(未注入的变量替换为空);
# 渲染结果输出到 chat_data.conf 供服务读取(服务 --conf 默认即该文件)。
# 本模板中所有可配置项(中间件地址/端口/账号/日志等级等)均通过环境变量注入,
# 环境变量的默认值在 docker-compose.yml 中通过 ${VAR:-默认值} 提供, 在 .env 中可统一覆盖。
# 敏感项(MySQL/Redis 密码, AI Key, SMTP 授权码)必须由宿主机 .env 或环境变量注入。

# ================= 日志 =================

# 日志输出文件路径, "stdout" 表示输出到标准输出, 其他值为日志文件路径
--logger_file=${LOGGER_FILE}
# 日志输出级别, 可选值 : trace / debug / info / warn / error / critical
--log_level=${LOG_LEVEL}

# ================= MySQL =================

--mysql_host=${MYSQL_HOST}
--mysql_port=${MYSQL_PORT}
--mysql_user=${MYSQL_USER}
--mysql_password=${MYSQL_PASSWORD}
--mysql_database=${MYSQL_DATABASE}
--mysql_charset=${MYSQL_CHARSET}
--mysql_connection_pool_size=${MYSQL_POOL}

# ================= Redis =================

--redis_host=${REDIS_HOST}
--redis_port=${REDIS_PORT}
--redis_user=${REDIS_USER}
--redis_password=${REDIS_PASSWORD}
--redis_db=${REDIS_DB}
--redis_pool_connections_size=${REDIS_POOL}

# ================= Etcd =================

--etcd_address=${ETCD_ADDR}

# 服务注册 TTL(秒)
--registry_ttl=${REGISTRY_TTL}

# ================= 子服务名称 =================
# 各子服务注册到 ETCD 注册中心的名称, 子服务间 RPC 调用通过该名称获取通信信道

--user_service=UserService
--file_service=FileService
--gateway_service=GatewayService
--ai_service=AIService
--excel_parse_service=ExcelParseService
--notify_service=NotifyService
--database_service=DataBaseService

# ================= 子服务监听参数 =================
# 各子服务容器单独配置, 运行时必须注入对应环境变量
--listen_port=${LISTEN_PORT}
--server_name=${SERVICE_NAME}
--server_addr=${SERVICE_ADDR}

# ================= FastDFS =================

# FastDFS tracker 服务器地址列表(逗号分隔)
--fdfs_tracker_servers=${FDFS_TRACKER_SERVERS}

# ================= 子服务特有参数 =================
# 以下参数由对应子服务单独定义, 其他子服务读取时自动忽略

# ChatSDK 本地 SQLite 数据库文件路径(AI 子服务)
--chat_sdk_db_path=aichat_sdk.db

# 邮箱用户名/授权码/发送者邮件号/SMTP 服务器地址/工作线程个数(通知子服务)
--smtp_username=${SMTP_USERNAME}
--smtp_password=${SMTP_PASSWORD}
--from_email=${FROM_EMAIL}
--smtp_server=${SMTP_SERVER}
--worker_thread_count=${WORKER_THREAD_COUNT}

# 前端静态文件根目录(网关服务)
--www_root=www

# AI 大模型配置 JSON 数组(AI 子服务, 含各模型 API Key, 运行时注入)
--chat_sdk_models=${CHAT_SDK_MODELS}