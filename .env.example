# ================================================================
# chat-excel 环境变量配置模板
# 使用方式 : cp .env.example .env 后按需修改
# 安全提示 : .env 包含密码 / 授权码 / API Key 等敏感信息, 已被 .gitignore 忽略, 严禁提交到仓库
# ================================================================

# ---------------- MySQL (必填) ----------------
# MySQL root 密码 (user / file / database / ai 服务必需)
MYSQL_PASSWORD=change-me

# MySQL 连接信息 (默认对接 chatexcel-net 网络内的 mysql 容器, 按需覆盖)
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_DATABASE=chat_excel
# MYSQL_CHARSET=utf8
# MYSQL_POOL=3

# ---------------- Redis (可选) ----------------
# Redis 密码 (无密码时留空)
# REDIS_PASSWORD=
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_USER=default
# REDIS_DB=0
# REDIS_POOL=3

# ---------------- etcd / 服务注册 (可选) ----------------
# ETCD_ADDR=http://etcd:2379
# REGISTRY_TTL=10

# ---------------- FastDFS (可选) ----------------
# FDFS_TRACKER_SERVERS=fastdfs-tracker:22122

# ---------------- 邮件通知 (必填, notify 服务使用) ----------------
# SMTP 账号 (通常是发件邮箱地址)
SMTP_USERNAME=your@qq.com
# SMTP 授权码 (在邮箱服务商后台生成, 不是邮箱登录密码)
SMTP_PASSWORD=your-smtp-auth-code
# 发件人邮箱
FROM_EMAIL=your@qq.com
# SMTP 服务器地址 (QQ 邮箱默认 smtp.qq.com:465, 163 邮箱 smtp.163.com:465)
# SMTP_SERVER=smtp.qq.com:465
# 邮件发送工作线程数
# WORKER_THREAD_COUNT=3

# ---------------- AI 模型 (必填, ai 服务使用) ----------------
# ChatSDK 模型配置 JSON 数组, 支持多模型; model_type/model_name 必填, 其余可选
# 支持 DEEPSEEK / GPT / GEMINI 等 model_type, apikey 为对应平台的 API Key
CHAT_SDK_MODELS=[{"model_type":"DEEPSEEK","model_name":"deepseek-chat","model_desc":"DeepSeek 对话模型","end_point":"https://api.deepseek.com","apikey":"sk-xxxxxxxx","path":"/chat/completions","streampath":"/chat/completions","model":"deepseek-chat"}]
# ChatSDK 会话消息库路径 (容器内路径, 建议保持默认指向挂载卷)
CHAT_SDK_DB_PATH=/home/chat_excel/data/aichat_sdk.db

# ---------------- 日志 (可选) ----------------
# 日志输出位置 : stdout 或日志文件路径
# LOGGER_FILE=stdout
# 日志级别 : trace / debug / info / warn / error / critical
# LOG_LEVEL=info
